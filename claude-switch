#!/usr/bin/env bash
# claude-switch — switch between Claude Code subscription logins.
#
#   claude-switch            switch to the only other session, or pick one
#   claude-switch NAME       switch to NAME (unknown NAME: start a fresh login slot)
#   claude-switch -l         list sessions
#
# Saved sessions live in $CFG/switch/NAME.json; $CFG/switch/active names the
# live one. No `active` file means the live login is unmanaged.
#
# What a switch moves (derived from Claude Code 2.1.280's own logout code):
#   - secure storage (.credentials.json / macOS Keychain): every key except
#     coworkRemoteDevice, which is device identity that logout also keeps
#   - ~/.claude.json: oauthAccount; the account-scoped caches logout clears are
#     dropped so Claude refetches them
set -euo pipefail

CFG=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then GLOBAL=$CFG/.claude.json; else GLOBAL=$HOME/.claude.json; fi
STORE=$CFG/switch
ACTIVE=$STORE/active
CREDS=$CFG/.credentials.json

DEVICE_KEYS='["coworkRemoteDevice"]'
CACHE_KEYS='["additionalModelOptionsCache","additionalModelOptionsAnsweredAt","additionalModelCostsCache",
  "modelAccessCache","orgModelDefaultCache","cachedArtifactRoster","artifactRosterDenied",
  "lastSeenOrgDefaultUpdatedAt","clientDataCache","clientDataCacheSlots","autoCompactWindowsCache",
  "cachedUsageUtilization","githubWebConnectionStatusCache","startupPrefetchedAt"]'

die() { echo "claude-switch: $*" >&2; exit 1; }

umask 077

# --- secure storage ---------------------------------------------------------

if [[ $(uname) == Darwin ]]; then
  KC_ACCOUNT=${USER:-$(id -un)}
  [[ $KC_ACCOUNT =~ ^[a-zA-Z0-9._-]+$ ]] || KC_ACCOUNT=claude-code-user
  KC_SERVICE="Claude Code-credentials"
  if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then
    KC_SERVICE+="-$(printf %s "$CFG" | shasum -a 256 | cut -c1-8)"
  fi

  secure_read() {
    security find-generic-password -a "$KC_ACCOUNT" -s "$KC_SERVICE" -w 2>/dev/null || true
  }
  secure_write() {
    # -X (hex) through `security -i` keeps the token out of the process list.
    local hex
    hex=$(printf %s "$1" | xxd -p | tr -d '\n')
    printf 'add-generic-password -U -a "%s" -s "%s" -X "%s"\n' "$KC_ACCOUNT" "$KC_SERVICE" "$hex" \
      | security -i >/dev/null
  }
else
  secure_read() { [[ -f $CREDS ]] && cat "$CREDS" || true; }
  secure_write() {
    local tmp
    tmp=$(mktemp "$CREDS.XXXXXX")
    printf '%s\n' "$1" >"$tmp"
    mv -f "$tmp" "$CREDS"
  }
fi

# --- helpers ----------------------------------------------------------------

active_name() { [[ -f $ACTIVE ]] && cat "$ACTIVE" || true; }

session_names() {
  local f
  for f in "$STORE"/*.json; do
    [[ -e $f ]] && basename "$f" .json
  done
}

valid_name() { [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]; }

global_update() {
  local tmp
  tmp=$(mktemp "$GLOBAL.XXXXXX")
  jq "$@" "$GLOBAL" >"$tmp"
  mv -f "$tmp" "$GLOBAL"
}

# Snapshot of the live login: {credentials, oauthAccount}, or empty if logged out.
live_snapshot() {
  local creds
  creds=$(secure_read)
  [[ -n $creds ]] || creds='{}'
  jq -n --argjson c "$creds" --argjson acct "$(jq '.oauthAccount // null' "$GLOBAL" 2>/dev/null || echo null)" \
    --argjson dev "$DEVICE_KEYS" '
    ($c | with_entries(select(.key as $k | $dev | index($k) | not))) as $creds
    | if ($creds | length) == 0 then empty
      else {credentials: $creds, oauthAccount: $acct} end'
}

save_live_as() {
  local snap
  snap=$(live_snapshot)
  if [[ -z $snap ]]; then
    echo "live login is empty; nothing saved for '$1'" >&2
    return
  fi
  printf '%s\n' "$snap" >"$STORE/$1.json"
}

# Load session file $1 into the live login; with no argument, clear it.
load_live() {
  local sess='{"credentials":{},"oauthAccount":null}' creds
  [[ -n ${1:-} ]] && sess=$(cat "$1")
  creds=$(secure_read)
  [[ -n $creds ]] || creds='{}'
  secure_write "$(jq -n --argjson c "$creds" --argjson s "$sess" --argjson dev "$DEVICE_KEYS" '
    ($c | with_entries(select(.key as $k | $dev | index($k)))) + $s.credentials')"
  global_update --argjson s "$sess" --argjson drop "$CACHE_KEYS" '
    (if $s.oauthAccount == null then del(.oauthAccount) else .oauthAccount = $s.oauthAccount end)
    | delpaths($drop | map([.]))'
}

label() {
  jq -r '.oauthAccount | if . then "\(.emailAddress // "?") (\(.organizationName // "?"))" else "?" end' "$1"
}

list() {
  local cur n mark
  cur=$(active_name)
  [[ -z $cur && -n $(live_snapshot) ]] && echo "* (unmanaged)"
  while read -r n; do
    [[ -n $n ]] || continue
    mark=" "; [[ $n == "$cur" ]] && mark="*"
    printf '%s %-16s %s\n' "$mark" "$n" "$(label "$STORE/$n.json")"
  done < <(session_names)
  [[ -n $cur && ! -f $STORE/$cur.json ]] && echo "* $cur (pending login)"
  return 0
}

refuse_if_running() {
  [[ ${FORCE:-0} == 1 ]] && return
  if pgrep -x -u "$(id -u)" claude >/dev/null; then
    die "claude is running; quit it first (it would write its old tokens back), or pass -f"
  fi
}

switch_to() {
  local target=$1 cur name
  valid_name "$target" || die "invalid name '$target' (use A-Z a-z 0-9 . _ -)"
  cur=$(active_name)
  [[ $target == "$cur" ]] && { echo "already on '$target'"; return; }
  refuse_if_running
  [[ -f $GLOBAL ]] || echo '{}' >"$GLOBAL"

  if [[ -n $cur ]]; then
    save_live_as "$cur"
  elif [[ -n $(live_snapshot) ]]; then
    read -rp "current login is unmanaged; save it as: " name || die "no name given"
    valid_name "$name" || die "invalid name '$name'"
    [[ $name != "$target" && ! -e $STORE/$name.json ]] || die "'$name' already exists"
    save_live_as "$name"
  fi

  if [[ -f $STORE/$target.json ]]; then
    load_live "$STORE/$target.json"
    echo "$target" >"$ACTIVE"
    echo "switched to '$target': $(label "$STORE/$target.json")"
  else
    load_live
    echo "$target" >"$ACTIVE"
    echo "new session '$target': run claude and /login; it is saved on the next switch"
  fi
}

pick() {
  local cur others=() n choice
  cur=$(active_name)
  while read -r n; do
    [[ -n $n && $n != "$cur" ]] && others+=("$n")
  done < <(session_names)
  case ${#others[@]} in
    0) die "no other sessions; use: claude-switch NAME" ;;
    1) switch_to "${others[0]}" ;;
    *)
      list
      read -rp "switch to: " choice || die "no name given"
      [[ -f $STORE/$choice.json ]] || die "no session '$choice'"
      switch_to "$choice"
      ;;
  esac
}

# --- main -------------------------------------------------------------------

command -v jq >/dev/null || die "jq not found"
mkdir -p "$STORE"

FORCE=0
args=()
for a in "$@"; do
  case $a in
    -f|--force) FORCE=1 ;;
    -l|--list) list; exit ;;
    -h|--help) echo "usage: claude-switch [-f] [NAME] | -l"; exit ;;
    -*) die "unknown option $a" ;;
    *) args+=("$a") ;;
  esac
done

case ${#args[@]} in
  0) pick ;;
  1) switch_to "${args[0]}" ;;
  *) die "usage: claude-switch [-f] [NAME] | -l" ;;
esac
